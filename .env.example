PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key

# PostgreSQL Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=fluxloc_db
DB_USER=fluxloc_user
DB_PASSWORD=fluxloc_pass

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID=fluxloc-service
KAFKA_TOPIC_LOCATION_UPDATES=driver-location-updates
